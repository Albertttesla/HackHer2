def run_scoring(dataset_path: str = "producers.csv") -> dict:
    print("\n" + "="*55)
    print("  AgroScore — Система скоринга сельхозпроизводителей")
    print("  Decentrathon 5.0 · Кейс 2")
    print("="*55 + "\n")
 
    # Загрузка
    df = load_dataset(dataset_path)
 
    # Признаки
    print("[1/4] Feature engineering...")
    features = engineer_features(df)
 
    # Скоринг
    print("[2/4] Расчёт скоров...")
    df["score"] = calculate_scores(features)
    df["rank"] = df["score"].rank(ascending=False, method="first").astype(int)
    df["status"] = df["score"].apply(get_status)
    df["explanation"] = [
        generate_explanation(df.iloc[i], features.iloc[i])
        for i in range(len(df))
    ]
 
    # Шортлист
    print("[3/4] Формирование шортлиста...")
    shortlist = build_shortlist(df)
 
    # Результаты
    print("[4/4] Результаты:\n")
    top10 = df.sort_values("score", ascending=False).head(10)
 
    print(f"{'Ранг':<5} {'Название':<25} {'Скор':<7} {'Статус':<22} {'Регион'}")
    print("-" * 75)
    for _, row in top10.iterrows():
        print(f"{row['rank']:<5} {str(row['name']):<25} {row['score']:<7} {row['status']:<22} {row['region']}")
 
    recommended = df[df["status"] == "Рекомендован"]
    total_requested = shortlist["requested_amount"].sum()
 
    print(f"\n{'─'*55}")
    print(f"  Всего заявок:          {len(df)}")
    print(f"  Рекомендовано:         {len(recommended)}")
    print(f"  В шортлисте:           {len(shortlist)}")
    print(f"  Сумма шортлиста:       ₸{total_requested:,.0f}")
    print(f"  Средний скор:          {df['score'].mean():.1f} / 100")
    print(f"{'─'*55}\n")
 
    # Экспорт
    output = {
        "metadata": {
            "total_applicants": len(df),
            "recommended_count": len(recommended),
            "shortlist_count": len(shortlist),
            "total_budget_used": total_requested,
            "avg_score": round(df["score"].mean(), 2),
            "model": "weighted_scoring_v1",
            "factors": FACTOR_WEIGHTS,
        },
        "rankings": df.sort_values("score", ascending=False)[
            ["id", "name", "region", "type", "score", "rank", "status", "explanation"]
        ].to_dict(orient="records"),
        "shortlist": shortlist[
            ["id", "name", "score", "shortlist_rank", "requested_amount", "status"]
        ].to_dict(orient="records"),
    }
 
    with open("agroscore_results.json", "w", encoding="utf-8") as f:
        json.dump(output, f, ensure_ascii=False, indent=2)
    print("[OK] Результаты сохранены в agroscore_results.json")
 
    df.to_csv("agroscore_ranked.csv", index=False, encoding="utf-8-sig")
    print("[OK] Таблица сохранена в agroscore_ranked.csv\n")
 
    return output
 
 
if __name__ == "__main__":
    # Замени путь на реальный датасет из Google Drive заказчика
    results = run_scoring("producers.csv")